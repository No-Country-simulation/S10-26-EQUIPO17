{
  "name": "React + Vite + Supabase",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "features": {
    // Docker CLI dentro del contenedor, hablando con el Docker del host
    // (los contenedores de Supabase corren "al lado", no adentro).
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  // El proyecto se monta en la MISMA ruta que en el host. Es necesario porque el
  // Supabase CLI le pasa rutas absolutas al Docker del host (p. ej. supabase/functions
  // para las edge functions) y el host tiene que poder encontrarlas.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // En Docker Engine (Linux) host.docker.internal no existe por defecto.
  // En Docker Desktop ya existe y esto no molesta.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  "containerEnv": {
    // Le dice al Supabase CLI dónde están escuchando los servicios (db, API, etc.).
    // Sin esto usaría 127.0.0.1, que dentro del contenedor es el propio contenedor.
    "SUPABASE_SERVICES_HOSTNAME": "host.docker.internal"
  },

  "remoteUser": "node",

  "forwardPorts": [5173, 3000],
  "portsAttributes": {
    "5173": { "label": "Vite", "onAutoForward": "openBrowserOnce" },
    "3000": { "label": "API", "onAutoForward": "notify" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "esbenp.prettier-vscode",
        "denoland.vscode-deno",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "oxc.enableHover": true,
        // Deno solo para las edge functions; el resto del proyecto es TS/React normal.
        "deno.enablePaths": ["supabase/functions"],
        "files.eol": "\n"
      }
    }
  }
}
