PORT=3000
# "supabase" (por defecto) o "memoria" para levantar la API sin base de datos
PERSISTENCIA=supabase
# Dentro del dev container usá host.docker.internal (ver .devcontainer/README.md)
SUPABASE_URL=http://host.docker.internal:54321
# Clave secreta (no la publicable): se obtiene con `pnpm supabase status`. Nunca va al frontend.
SUPABASE_SECRET_KEY=
# Cookies de sesión. COOKIE_SAME_SITE: "lax" (por defecto), "strict" o "none".
# "none" solo hace falta si la web y la API están en sitios distintos, y exige COOKIE_SECURE.
COOKIE_SAME_SITE=lax
# "false" solo en desarrollo sobre http; por defecto las cookies son Secure.
COOKIE_SECURE=true